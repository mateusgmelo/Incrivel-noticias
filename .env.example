# --- Banco de dados ---
# Local (docker compose up -d db): as duas URLs são iguais.
# Produção (Neon): DATABASE_URL = string "pooled" (host com -pooler), DIRECT_URL = string direta.
DATABASE_URL="postgresql://incrivel:incrivel@localhost:5433/incrivel?schema=public"
DIRECT_URL="postgresql://incrivel:incrivel@localhost:5433/incrivel?schema=public"

# --- Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"

# --- Cron de importação RSS (Vercel envia como Bearer token) ---
CRON_SECRET="troque-este-segredo"

# --- Seed: senha dos usuários de demonstração ---
SEED_DEFAULT_PASSWORD="Incrivel@2026"
